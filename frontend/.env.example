# Base URL of the FastAPI backend as seen by the browser.
# Leave empty in development: Vite proxies /api to VITE_DEV_PROXY_TARGET so auth cookies stay same-origin.
# In production set it to the API origin (e.g. https://api.example.com) and add the frontend origin to the
# backend's ALLOWED_ORIGINS; cross-site deployments also need COOKIE_SECURE=true and COOKIE_SAMESITE=none.
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
# Client-side resume size check in MB; keep it equal to the API RESUME_MAX_BYTES (4 on Vercel + Render).
VITE_RESUME_MAX_MB=5
