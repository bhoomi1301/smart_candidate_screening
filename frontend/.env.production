# Production build settings (no secrets; safe to commit).
# Empty: the browser calls /api on the same origin and Vercel proxies it to Render (see vercel.json),
# which keeps the HttpOnly auth cookies first-party.
VITE_API_BASE_URL=
# Matches RESUME_MAX_BYTES=4194304 on the API (Vercel proxy body limit is ~4.5 MB).
VITE_RESUME_MAX_MB=4
