APP_ENV=development
POSTGRES_DB=screening
POSTGRES_USER=screening
POSTGRES_PASSWORD=replace-this-local-password
DATABASE_URL=postgresql+psycopg://screening:replace-this-local-password@localhost:5432/screening
ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=replace-the-demo-password
SEED_HR_PASSWORD=replace-the-hr-password
ALLOWED_ORIGINS=["http://localhost:5173"]
# Optional: GET / on the API redirects here (the TalentLens frontend).
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Resume uploads (PDF only, stored in PostgreSQL). Also cap request bodies at your reverse proxy (e.g. 6 MB).
RESUME_MAX_BYTES=5242880
RESUME_MAX_PAGES=50
